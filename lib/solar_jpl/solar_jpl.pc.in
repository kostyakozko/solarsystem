prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/include

Name: solar_jpl
Description: Solar System Suite - JPL HORIZONS API Client
Version: @PROJECT_VERSION@
URL: https://github.com/solarsystem/solarsystem

Requires: solar_core
Cflags: -I${includedir}
Libs: -L${libdir} -lsolar_jpl
Libs.private: -lpthread
