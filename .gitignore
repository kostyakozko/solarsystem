# Compiled object files and executables
*.o
*.s
/solar_system
gmon.out

# Ephemeris cache files
*.json
*.bin

# Exception: Allow test data files
!tests/**/test_*.json
!tests/**/*_test.json

# CMake build files and directories
build/
install/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
# Only ignore generated cmake files, not our cmake/ directory files
/cmake_install.cmake
**/CMakeFiles/
**/CMakeCache.txt
!CMakeLists.txt
!cmake/*.cmake

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# macOS specific
.DS_Store
.AppleDouble
.LSOverride

# Profiling output
*.prof
*.gprof

# Debug and temporary files
debug_*.cpp
test_*_verification.cpp
temp_*.cpp

# Performance baseline CSV files (generated artifacts)
baseline_performance/*.csv
build/tests/benchmarks/benchmark_results/*.csv
