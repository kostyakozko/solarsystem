# Solar System Suite - Performance Monitoring Container
FROM ubuntu:22.04 AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake=3.22.* \
    g++=4:11.* \
    curl=7.81.* \
    git=1:2.34.* \
    libcurl4-openssl-dev=7.81.* \
    libssl-dev=3.0.* \
    zlib1g-dev=1:1.2.* \
    libboost-dev=1.74.* \
    ca-certificates=* \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

RUN cmake -B build -DCMAKE_BUILD_TYPE=Release -DENABLE_TESTING=OFF \
    && cmake --build build -j"$(nproc)"

FROM ubuntu:22.04
RUN apt-get update && apt-get install -y --no-install-recommends \
    libcurl4=7.81.* \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /src/build/apps/solar_system_web/solar_system_web /usr/local/bin/
COPY --from=builder /src/apps/solar_system_web/web /usr/local/share/solar_system/web

EXPOSE 8080
ENTRYPOINT ["solar_system_web"]
CMD ["--port", "8080", "--web-root", "/usr/local/share/solar_system/web"]
