# SolarSystemConfigVersion.cmake - Version compatibility checking
#
# This file is automatically generated and used by find_package()
# to check version compatibility.

set(PACKAGE_VERSION "@PROJECT_VERSION@")

# Check whether the requested version is compatible
if("${PACKAGE_FIND_VERSION_MAJOR}" EQUAL "@PROJECT_VERSION_MAJOR@")
    # Same major version - compatible
    if("${PACKAGE_FIND_VERSION}" VERSION_LESS_EQUAL "${PACKAGE_VERSION}")
        set(PACKAGE_VERSION_COMPATIBLE TRUE)
    else()
        set(PACKAGE_VERSION_COMPATIBLE FALSE)
    endif()

    # Exact match check
    if("${PACKAGE_FIND_VERSION}" VERSION_EQUAL "${PACKAGE_VERSION}")
        set(PACKAGE_VERSION_EXACT TRUE)
    endif()
else()
    # Different major version - incompatible
    set(PACKAGE_VERSION_COMPATIBLE FALSE)
endif()

# Architecture check for shared libraries
if(NOT CMAKE_SIZEOF_VOID_P STREQUAL "@CMAKE_SIZEOF_VOID_P@")
    set(PACKAGE_VERSION_UNSUITABLE TRUE)
endif()
