#!/bin/bash
# Pre-commit hook to run clang-format on staged C++ files

# Get list of staged C++ files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(cpp|hpp|h)$')

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

# Check if clang-format is available
if ! command -v clang-format &> /dev/null; then
    echo "Warning: clang-format not found, skipping format check"
    exit 0
fi

# Format staged files
echo "Running clang-format on staged files..."
for FILE in $STAGED_FILES; do
    if [ -f "$FILE" ]; then
        clang-format -i "$FILE"
        git add "$FILE"
    fi
done

echo "✅ clang-format complete"
